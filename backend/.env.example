NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=hospital_it_helpdesk_dev
DB_USER=helpdesk_dev
DB_PASSWORD=

# Optional encrypted administrative backups; keep the key private and outside Git.
# ADMIN_BACKUP_KEY= (base64-encoded 32 random bytes)
# ADMIN_BACKUP_DIRECTORY=D:/private-helpdesk-backups

# Optional asset CSV/XLSX reader (Python 3)
# HELPDESK_PYTHON=python
# Optional Arabic-capable PDF font; Windows defaults to installed Arial
# ASSET_REPORT_FONT=C:/Windows/Fonts/arial.ttf
# Optional. Which proxies may set X-Forwarded-For (Express trust proxy). Default: loopback only.
# TRUST_PROXY=loopback
